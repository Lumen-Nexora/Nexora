# Server
PORT=3000
ENV=development
# Structured logging level: debug, info, warn, or error (default: info)
LOG_LEVEL=info
# Set false in a secondary region; the API remains active but no worker is started.
WORKER_ENABLED=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexora?sslmode=disable
# Optional read replica; reads fall back to DATABASE_URL when unavailable
REPLICA_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379
# Optional Redis Sentinel configuration. When set, Sentinel takes precedence over REDIS_URL.
REDIS_SENTINEL_MASTER_NAME=
REDIS_SENTINEL_ADDRS=
REDIS_SENTINEL_PASSWORD=

# Stellar network profiles. sk_live_ keys always use the live profile;
# sk_test_ keys always use the isolated testnet profile.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar Core RPC endpoint. Reported by GET /health as the "stellar_core"
# dependency; when unset, /health reports that dependency as down.
STELLAR_CORE_URL=

# Sandbox / test mode. Tenants holding an sk_test_ key operate entirely against
# testnet: wallets are funded by Friendbot and never touch mainnet funds.
STELLAR_LIVE_NETWORK=mainnet
STELLAR_LIVE_HORIZON_URL=https://horizon.stellar.org
STELLAR_TESTNET_NETWORK=testnet
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org
# USDC issuer on Stellar testnet
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Key management — must be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace_with_64_char_hex_string

# Envelope encryption of custodial wallet seeds (optional, see
# docs/kms-envelope-encryption.md). With a KMS each seed gets its own data key,
# wrapped by a key that never leaves the KMS. MASTER_ENCRYPTION_KEY is still
# required: it opens seeds sealed before the KMS was enabled.
# KMS_PROVIDER: none | aws | gcp | vault
KMS_PROVIDER=none
# Automatic key rotation applied to the KMS key at startup, e.g. 2160h (90d).
# AWS accepts 90-2560 days, GCP at least 24h, Vault at least 1h.
KMS_ROTATION_PERIOD=
AWS_REGION=
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_KMS_ENDPOINT=
# Full CryptoKey name: projects/P/locations/L/keyRings/R/cryptoKeys/K.
# Leave GCP_ACCESS_TOKEN empty to use the GCE/GKE metadata server.
GCP_KMS_KEY_NAME=
GCP_ACCESS_TOKEN=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=

# JWT signing secret — required in every environment (development, staging, production).
# Must be at least 32 bytes. No default is provided; the server refuses to start without it.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret

# Treasury wallet funds newly created accounts (testnet: leave empty, use Friendbot)
TREASURY_SECRET_KEY=

# Platform fee collection wallet (Stellar public key)
PLATFORM_FEE_WALLET_PUBLIC_KEY=

# Platform wallet ID (wallet UUID) — required when COMPLIANCE_ENABLED=true.
# The compliance screener exempts this wallet from velocity/structuring rules
# so the platform's own refunds, sweeps and fee movements are not held.
PLATFORM_WALLET_ID=

# Cold storage wallet (Stellar public key, optional)
COLD_STORAGE_ADDRESS=

# Custodial deposit sweep (optional). Moves deposits above these thresholds
# from custodial wallets into each tenant's master address, keeping every
# wallet's minimum reserve. Tenants opt in with auto_sweep_enabled on
# PUT /v1/wallets/custody-settings. Empty disables the sweep entirely.
# Format: ASSET[:ISSUER]=AMOUNT, comma separated, e.g. XLM=25,USDC=100
CUSTODIAL_SWEEP_THRESHOLDS=
CUSTODIAL_SWEEP_INTERVAL=@every 15m
CUSTODIAL_SWEEP_CONCURRENCY=8

# EURC issuer on Stellar (optional, validated when TREASURY_SECRET_KEY is set)
STELLAR_EURC_ISSUER=

# CORS allowed origins (comma-separated). Defaults to localhost:* in
# development. Set explicitly for staging/production.
CORS_ALLOWED_ORIGINS=localhost:*

# Idempotency record TTL in hours (default: 24, minimum: 1)
IDEMPOTENCY_TTL_HOURS=24

# FX spread in basis points (default: 50)
FX_SPREAD_BPS=50

# Soroban RPC URL (default: soroban-testnet)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# On-chain audit attestation (optional). When AUDIT_ATTESTATION_CONTRACT_ID is
# set, the worker commits a daily Merkle root of the audit trail to the
# attestation contract at midnight UTC. The maintainer account must be
# registered on the contract; its secret is encrypted with MASTER_ENCRYPTION_KEY.
AUDIT_ATTESTATION_CONTRACT_ID=
AUDIT_ATTESTATION_MAINTAINER=
AUDIT_ATTESTATION_ENCRYPTED_SECRET=

# Contract wallet configuration
CONTRACT_WALLET_SPENDING_LIMIT=1000
CONTRACT_WALLET_WINDOW_SECONDS=86400
CONTRACT_WALLET_RECOVERY_THRESHOLD=2

# Indexer configuration
INDEXER_PAYMENTS_PAGE_LIMIT=50
INDEXER_STREAM_MIN_BACKOFF=1s
INDEXER_STREAM_MAX_BACKOFF=30s
INDEXER_SYNC_PAGE_SIZE=100
INDEXER_STREAM_CONCURRENCY=32
INDEXER_STREAM_MAX_WALLETS=32
INDEXER_STREAM_SHARD_COUNT=1
INDEXER_STREAM_SHARD_INDEX=0
INDEXER_METRICS_PORT=9090

# Migrations path (relative to binary working directory)
MIGRATIONS_PATH=db/migrations

# Alerting webhook URL (Slack or generic webhook for reconciliation alerts)
# Leave empty to disable alerting
ALERT_WEBHOOK_URL=

# Balance drift threshold, in USD, that triggers a reconciliation alert.
# A drift of exactly this amount does not alert; only amounts above it do.
# Leave empty to default to 1.
RECONCILIATION_DRIFT_THRESHOLD_USD=1

# Auto-remediation of transient discrepancies (#120). A confirmed transaction
# Horizon returns 404 for, created within the window, is re-checked on each
# ledger close instead of being flagged at once. It is resolved only if
# Horizon then shows it and every reconciliation check passes; otherwise it
# is escalated (flagged + alerted) once it has persisted for more than
# MAX_CYCLES consecutive cycles or for longer than MAX_AGE.
RECONCILIATION_AUTO_REMEDIATION_ENABLED=true
RECONCILIATION_AUTO_REMEDIATION_WINDOW=10m
RECONCILIATION_AUTO_REMEDIATION_MAX_CYCLES=3
RECONCILIATION_AUTO_REMEDIATION_MAX_AGE=15m

# Distributed tracing (OpenTelemetry). Disabled by default: with OTEL_ENABLED
# unset, no spans are recorded or exported and the request path is unchanged.
OTEL_ENABLED=false
# OTLP/HTTP collector base URL. Spans are POSTed to <endpoint>/v1/traces.
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
# Reported as the service name on every span.
OTEL_SERVICE_NAME=nexora

# ---------------------------------------------------------------------------
# Travel Rule / IVMS 101 (disabled unless a trusted VASP directory is configured)
TRAVEL_RULE_ENABLED=false
TRAVEL_RULE_THRESHOLD_USD=1000
TRAVEL_RULE_ORIGINATING_VASP_ID=nexora
# JSON array of trusted VASPs with id, protocol (trp|openvasp), HTTPS endpoint,
# base64url X25519 encryption_public_key, base64url Ed25519 confirmation_public_key,
# and optionally bearer_token plus client_cert_file/client_key_file for partner auth/mTLS.
TRAVEL_RULE_VASP_DIRECTORY_JSON=

# Compliance screening (issue #69)
# ---------------------------------------------------------------------------
# Master switch. When false, no screener is attached and transfers are not
# screened. Screening otherwise fails CLOSED: if the sanctions list cannot be
# loaded, transfers are held for review rather than cleared.
COMPLIANCE_ENABLED=true

# OFAC SDN list. Operator-configured, never user-supplied. Refreshed daily by
# cmd/worker; every process reloads from the sanctions_entities table.
OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/download/sdn.xml

# Official UN consolidated XML and EU Commission FSF 1.1 XML. The EU export
# may require an account-specific ?token=... supplied by the Commission.
# Use an operator-controlled secret for the token, not a user-provided URL.
UN_SANCTIONS_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
EU_SANCTIONS_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/xmlFullSanctionsList_1_1/content

# A 0..1 minimum combined Jaro-Winkler + Double Metaphone match score.
# Name hits are ALWAYS held for manual review, not automatically blocked.
COMPLIANCE_SIMILARITY_THRESHOLD=0.85

# Structuring rule: flags when the running total to one destination sits
# within 5% below the next multiple of this unit (3 x 999 flags, 3 x 1000
# does not).
COMPLIANCE_STRUCTURING_UNIT=1000

# Velocity rule: more than this many transfers from one org inside the window
# holds the next one.
COMPLIANCE_VELOCITY_MAX_TRANSFERS=10
COMPLIANCE_VELOCITY_WINDOW_MINUTES=10

# Round-trip rule: holds when the source already received funds from this
# destination inside the window.
COMPLIANCE_ROUND_TRIP_WINDOW_MINUTES=60

# Legacy name-edit-distance setting (deprecated). Use the similarity score above.
COMPLIANCE_FUZZY_THRESHOLD=2

# How often each process reloads the sanctions set from the database. This is
# what carries the worker's daily refresh into the API process's memory.
COMPLIANCE_RELOAD_MINUTES=15

# ---------------------------------------------------------------------------
# Claimable balances (issue #70)
# ---------------------------------------------------------------------------
# Wallet UUID used as the funding account when a create request does not name a
# source wallet. Leave empty to require source_wallet_id on every request.
CLAIMABLE_BALANCE_SOURCE_WALLET_ID=

# The expiry tracker itself needs no configuration: cmd/worker runs
# "claimable:expire" every 5 minutes, which marks unclaimed balances past their
# expires_at and claims back the ones created with revoke_on_expiry.
